(version 1)

# The Alps SKRT side switch (SW1) has two plastic locating bosses whose NPTH
# holes sit ~0.07 mm from its own pads (manufacturer land pattern). Board
# setup therefore has a low hole-clearance floor and this rule restores the
# normal 0.25 mm for everything that is not internal to SW1.
(rule "hole clearance outside SW1"
  (condition "!(A.memberOfFootprint('SW1') && B.memberOfFootprint('SW1'))")
  (constraint hole_clearance (min 0.25)))
