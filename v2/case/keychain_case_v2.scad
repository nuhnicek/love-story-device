// GSM touch keychain v2 - 3D-printable case (tray + lid), parametric.
// Module version: Seeed XIAO ESP32-C3 + SIM800L red mini + 802530 LiPo, no custom PCB.
// OpenSCAD 2026+.  Export:  v2/case/build.sh  (STL + previews + G-code)
//
// Stack, bottom to top:
//   floor | LiPo 802530 (30 x 25 x 8) | XIAO (USB-C at the USB end) + side switch behind it
//   + small parts beside it | SIM800L (SIM holder down) | heart perfboard (10 x 3 mm LEDs,
//   resistors, 0820 motor) | lid with 10 LED holes
//
// heart_layout.scad is generated by ../../enclosure/heart_perfboard.py (same perfboard as v1).
//
// Coordinates: interior origin = inner floor corner. +X = across the keychain
// (antenna channel on the left), +Y = from the USB-C end to the button / keyring end.
//
// ALL PART SIZES BELOW ARE DATASHEET/TYPICAL VALUES. Measure your battery, XIAO and switch
// with calipers and fix the numbers before printing the final case.

include <heart_layout.scad>

part = "assembly";   // "tray" | "lid" | "plate" (2 trays + 2 lids) | "assembly"

/* [Battery: 802530 LiPo with protection board] */
bat_w = 30; bat_l = 25; bat_h = 8.0;   // 8 x 25 x 30 mm, ~500 mAh (30 mm across, 25 mm along)
bat_clr = 0.4;                          // pouch cells vary +-0.5 mm

/* [XIAO ESP32-C3] */
xiao_w = 17.8; xiao_l = 21.0;
xiao_pcb = 1.2;          // PCB thickness
xiao_under = 0.8;        // wires on the BAT+/BAT- pads underneath + tape
usb_w = 8.94; usb_h = 3.2;   // USB-C receptacle on the XIAO's top side
xiao_y0 = 0.6;           // PCB edge from the USB-end wall (receptacle overhangs the PCB)

/* [Side switch: 3 x 6 x 4.3 mm 2-pin tact, lying on its side] */
sw_w = 6.0;              // across (X)
sw_d = 3.5;              // height (Z)
sw_len = 4.3;            // body + stem, along the press direction (Y)

/* [SIM800L red mini and heart perfboard] */
board_w = 25.2; board_l = 23.0;   // SIM800L outline
sim_gap = 1.5;           // micro-SIM holder under the module
module_h = 3.2;          // SIM800L PCB + shield
hb_t = 1.6;              // universal board thickness
under_h = 1.3;           // solder joints + wires + tape under the perfboard
led_h = 5.3;             // 3 mm LED height above the board, flange to dome top (measure yours!)
led_protrude = 1.5;      // how far the LED domes stick out of the lid
led_hole = 3.2;
motor_d = 8.0; motor_h = 2.0;
res_h = 1.9;

/* [Case] */
wall = 1.6;
floor_t = 1.2;
lid_t = 1.2;
corner_r = 2.5;
clr = 0.3;
fit = 0.15;              // tray/lid joint clearance
lip_h = 2.2;
post_d = 2.2;
antenna = true;          // channel for the SIM800L spring antenna (left side)
antenna_w = 4.5;
loop_d = 4.2; loop_od = 9; loop_t = 3.6; loop_x = 5;

$fn = 64;

// ------------------------------------------------------------------ derived
ant = antenna ? antenna_w : 0;
iw = max(ant + board_w + 2 * clr, bat_w + 2 * bat_clr);          // interior width  (X)
xiao_x0 = iw - clr - xiao_w;                                     // XIAO on the right
xiao_cx = xiao_x0 + xiao_w / 2;                                  // USB-C + switch centre line
sw_y0 = xiao_y0 + xiao_l + 0.2;                                  // switch back, against the XIAO
sw_tip = sw_y0 + sw_len;
il = max(bat_l + 2 * bat_clr, board_l + 2 * clr, sw_tip + 0.6);  // interior length (Y)
bx0 = ant + clr;                                                 // SIM800L left edge

z_bat_top = bat_h + 0.2;
z_xiao_bot = z_bat_top + xiao_under;
z_xiao_top = z_xiao_bot + xiao_pcb;
z_usb_c = z_xiao_top + usb_h / 2;
z_sw_c = z_bat_top + sw_d / 2;
z_sim_bot = max(z_xiao_top + usb_h, z_bat_top + sw_d) + 0.2;    // SIM holder underside
z_mod_top = z_sim_bot + sim_gap + module_h;
z_hb_bot = z_mod_top + under_h;
z_hb_top = z_hb_bot + hb_t;
above_board = led_h - led_protrude - lid_t;
assert(above_board >= max(motor_h, res_h) + 0.2, "LEDs too short: motor/resistors would hit the lid");
ih = z_hb_top + above_board;
z_split = ih - lip_h;
tongue = wall / 2;

heart_c = [iw / 2, il / 2] - hb_centre;
assert(hb_w + 0.4 <= iw && hb_h + 0.4 <= il, "perfboard does not fit the interior");

echo(str("Interior: ", iw, " x ", il, " x ", ih, " mm"));
echo(str("Outer size: ", iw + 2 * wall, " x ", il + 2 * wall, " x ", ih + floor_t + lid_t,
         " mm (+ ", led_protrude, " mm LED domes, + keyring loop)"));
echo(str("Free bay left of the XIAO for C1/Q1/resistors: ", xiao_x0 - clr, " x ", il, " x ",
         z_sim_bot - 0.2 - z_bat_top, " mm"));

// ------------------------------------------------------------------ helpers
module rrect(w, l, r) {
  translate([r, r]) offset(r = r) square([max(w - 2 * r, 0.01), max(l - 2 * r, 0.01)]);
}
module interior2d(grow = 0) {
  translate([-grow, -grow]) rrect(iw + 2 * grow, il + 2 * grow, max(0.5 + grow, 0.5));
}
module outer2d() { translate([-wall, -wall]) rrect(iw + 2 * wall, il + 2 * wall, corner_r); }

module snaps(h_extra = 0, d = 0.3) {
  for (sx = [0, 1]) {
    x = sx == 0 ? -tongue : iw + tongue;
    translate([x, il / 2, z_split + lip_h * 0.45])
      rotate([90, 0, 0]) linear_extrude(height = 8 + h_extra, center = true)
        polygon(sx == 0 ? [[0, -0.6], [-d, 0], [0, 0.6]] : [[0, -0.6], [d, 0], [0, 0.6]]);
  }
}

// ------------------------------------------------------------------ tray
module usb_cutout() {
  // opening for the receptacle
  translate([xiao_cx, -wall - 1, z_usb_c]) rotate([-90, 0, 0])
    linear_extrude(height = wall + 2) offset(r = 1.2) square([usb_w + 0.6 - 2.4, usb_h + 0.6 - 2.4], center = true);
  // outside recess so the plug's overmold sits close to the receptacle
  translate([xiao_cx, -wall - 1, z_usb_c]) rotate([-90, 0, 0])
    linear_extrude(height = 1 + wall - 0.5) offset(r = 2.5) square([12.8 - 5, 7.0 - 5], center = true);
}

module button_tab(cut = true) {
  // U-shaped slot through the end wall leaves a flexing tab hinged at the bottom;
  // a nub on its inside presses the switch stem.
  tw = 4.6; th = 6.2; slot = 0.5;
  z0 = z_sw_c - th / 2 - 1.2;
  if (cut) {
    translate([xiao_cx, il - 0.01, z0]) difference() {
      translate([-tw / 2 - slot, 0, 0]) cube([tw + 2 * slot, wall + 0.02, th + slot]);
      translate([-tw / 2, -0.01, -0.01]) cube([tw, wall + 0.04, th]);
    }
  } else {
    nub = il - sw_tip - 0.05;
    translate([xiao_cx - 1.0, il - nub, z_sw_c - 0.6]) cube([2.0, nub + 0.01, 1.2]);
  }
}

module keyring() {
  translate([loop_x, il + wall + loop_od / 2 - 1.2, -floor_t]) difference() {
    hull() {
      cylinder(d = loop_od, h = loop_t);
      translate([-loop_od / 2, -loop_od / 2 - 0.5, 0]) cube([loop_od, 0.1, loop_t]);
    }
    translate([0, 0, -1]) cylinder(d = loop_d, h = loop_t + 2);
  }
}

module tray() {
  difference() {
    union() {
      translate([0, 0, -floor_t]) linear_extrude(height = z_split + floor_t) outer2d();
      translate([0, 0, z_split - 0.01]) linear_extrude(height = lip_h + 0.01)
        difference() { interior2d(tongue); interior2d(0); }
      snaps();
      keyring();
    }
    linear_extrude(height = ih + 1) interior2d(0);
    usb_cutout();
    button_tab(cut = true);
  }
  button_tab(cut = false);
}

// ------------------------------------------------------------------ lid
module lid() {
  difference() {
    union() {
      translate([0, 0, ih]) linear_extrude(height = lid_t) outer2d();
      translate([0, 0, z_split]) linear_extrude(height = lip_h + 0.01)
        difference() { outer2d(); interior2d(tongue + fit); }
      for (p = hb_posts) translate([heart_c[0] + p[0], heart_c[1] + p[1], z_hb_top + 0.1])
        cylinder(d = post_d, h = ih - z_hb_top);
    }
    for (p = hb_leds) translate([heart_c[0] + p[0], heart_c[1] + p[1], 0]) {
      translate([0, 0, ih - 1]) cylinder(d = led_hole, h = lid_t + 2);
      translate([0, 0, ih + lid_t - 0.4]) cylinder(d1 = led_hole, d2 = led_hole + 0.8, h = 0.41);
    }
    snaps(h_extra = 0.6, d = 0.35);
  }
}

// ------------------------------------------------------------------ contents (preview only)
module contents() {
  color("silver", 0.9) translate([bat_clr, bat_clr, 0]) cube([bat_w, bat_l, bat_h]);
  color("royalblue") translate([xiao_x0, xiao_y0, z_xiao_bot]) cube([xiao_w, xiao_l, xiao_pcb]);
  color("gainsboro") translate([xiao_cx - usb_w / 2, xiao_y0 - 0.6, z_xiao_top]) cube([usb_w, 7.4, usb_h]);
  color("black") translate([xiao_cx - sw_w / 2, sw_y0, z_bat_top]) cube([sw_w, sw_len - 1.2, sw_d]);
  color("dimgray") translate([xiao_cx, sw_y0 + sw_len - 1.2, z_sw_c]) rotate([-90, 0, 0]) cylinder(d = 1.5, h = 1.2);
  color("goldenrod") translate([1.5, 3, z_bat_top]) cube([7.3, 4.3, 2.8]);          // C1 tantalum
  color("firebrick") translate([bx0, clr, z_sim_bot + sim_gap]) cube([board_w, board_l, module_h]);
  color("tan") translate([heart_c[0] + hb_centre[0] - hb_w / 2, heart_c[1] + hb_centre[1] - hb_h / 2, z_hb_bot])
    cube([hb_w, hb_h, hb_t]);
  color("dimgray") translate([heart_c[0] + hb_motor[0], heart_c[1] + hb_motor[1], z_hb_top]) cylinder(d = motor_d, h = motor_h);
  for (p = hb_leds) color("hotpink") translate([heart_c[0] + p[0], heart_c[1] + p[1], z_hb_top]) {
    cylinder(d = 3.8, h = 1.0);
    cylinder(d = 3.0, h = led_h - 1.5);
    translate([0, 0, led_h - 1.5]) sphere(d = 3.0);
  }
}

// ------------------------------------------------------------------ output
module lid_print() { translate([0, 0, ih + lid_t]) rotate([180, 0, 0]) translate([0, -il, 0]) lid(); }
pitch_x = iw + 2 * wall + 8;
pitch_y = il + 2 * wall + loop_od + 6;

if (part == "plate") {
  for (i = [0, 1]) {
    translate([i * pitch_x, 0, floor_t]) tray();
    translate([i * pitch_x, pitch_y, 0]) lid_print();
  }
} else if (part == "tray") {
  tray();
} else if (part == "lid") {
  lid_print();
} else if (part == "inside") {      // tray cut open + contents, no lid
  difference() { tray(); translate([-10, -10, z_bat_top + 2]) cube([60, 60, 60]); }
  contents();
} else {
  tray();
  contents();
  color("white", 0.45) translate([0, 0, 6]) lid();
}
