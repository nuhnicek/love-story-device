	(text "CP2102N runs only from USB (VREGIN = VBUS), its I/O at its own 3.3 V (VIO = VDD)."
		(exclude_from_sim no)
		(at 411.48 185.42 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "6f79c7ba-2720-5483-91e0-50fef355c15b")
	)
	(text "R12/R13: 4.7k series to the nRF9151 UART. The firmware turns the UART off"
		(exclude_from_sim no)
		(at 411.48 187.96 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "5507b448-73c4-52b8-8e82-c8644d7d45d6")
	)
	(text "  when USB_DET is low, so nothing leaks into the unpowered CP2102N on battery."
		(exclude_from_sim no)
		(at 411.48 190.5 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "bd091e92-d3ce-516a-ab30-647d3757ad76")
	)
	(text "Q2 (digital NPN, 10k/10k inside) auto-reset: nRESET is pulled low only when DTR is high"
		(exclude_from_sim no)
		(at 411.48 193.04 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "5919955b-96f6-5217-8f33-b15ac441d9f0")
	)
	(text "  and RTS is low. Idle (both high), port open (both low) and USB unplugged: no reset."
		(exclude_from_sim no)
		(at 411.48 195.58 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "12a27265-10a7-59e2-8b59-8f65200bf490")
	)
	(text "Flash: MCUboot (installed once over SWD) waits ~0.5 s after reset for mcumgr"
		(exclude_from_sim no)
		(at 411.48 198.12 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "d1390f1d-bb0f-59e7-ad9f-53b5b10bb3bc")
	)
	(text "  over this UART, so the PC can reset the board and upload new firmware."
		(exclude_from_sim no)
		(at 411.48 200.66 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "188bd099-0c7c-56a0-929a-2f5cc4422edf")
	)
	(text "USB_DET (P0.31): VBUS/2, high while USB-C is plugged in"
		(exclude_from_sim no)
		(at 411.48 203.2 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "b3902217-04e3-54a1-8fe8-b143fde2d4d5")
	)
